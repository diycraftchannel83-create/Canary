rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isFarmMember(aviaryId) {
      return request.auth != null &&
        firestore.get(/databases/ai-studio-android-kenaripe-62004774-6ed3-4939-83d3-a67475913af9/documents/aviaries/$(aviaryId)).data.memberUids.hasAny([request.auth.uid]);
    }

    match /aviaries/{aviaryId}/farm_logo/{fileName} {
      allow read: if isFarmMember(aviaryId);
      allow write: if isFarmMember(aviaryId) &&
        fileName == 'logo' &&
        request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isFarmMember(aviaryId);
    }
  }
}
